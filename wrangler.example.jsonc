{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jarvis",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-17",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/", // rewritten to ../client by @cloudflare/vite-plugin at build
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Optional: serve Jarvis on your own domain. Use a Custom Domain, not a
  // route - routes cannot be the target of a same-zone fetch(). Without this,
  // enable workers_dev below and Jarvis lives at <name>.<you>.workers.dev.
  // "routes": [
  //   { "pattern": "jarvis.example.com", "custom_domain": true }
  // ],
  // With a custom domain above, set this false so the Worker is ONLY served
  // there - otherwise it also appears at *.workers.dev, outside your zone's
  // WAF and bot rules. Without a custom domain, leave it true.
  "workers_dev": true,
  "preview_urls": false,
  // Per-device burst control. Cloudflare's own limiter: no state to keep, and
  // it catches a device stuck in a reconnect loop within seconds. Note it is
  // enforced per location rather than globally, and `period` accepts only 10 or
  // 60 - so this bounds a runaway loop, it is not a spend cap. The daily budget
  // in lib/limits.ts is what protects the bill.
  "ratelimits": [
    { "name": "DEVICE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  "kv_namespaces": [
    { "binding": "CONFIG", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }  // npx wrangler kv namespace create CONFIG
  ],
  // Optional, Cloudflare only: Workers AI for the cheapest push-to-talk hearing
  // (Whisper) and speaking (Deepgram Aura), chosen in Settings → Push-to-talk
  // voice. Without it, OpenAI does both. Leave it out for Docker.
  // "ai": { "binding": "AI" },

  // Memory and the daily device counter (src/worker/state.ts). SQLite-backed,
  // because that is the only kind of Durable Object the Workers free plan
  // allows; `new_classes` would be the key-value kind and fail to deploy.
  "durable_objects": {
    "bindings": [{ "name": "STATE", "class_name": "JarvisState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JarvisState"] }]
}

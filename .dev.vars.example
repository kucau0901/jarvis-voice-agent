# Copy to .dev.vars for local dev. NEVER commit the real file.
#
# Only JARVIS_SHARED_SECRET is required. Everything below it can instead be set
# in the app's settings panel, which is the easier way; a value here is the
# fallback when the panel has none.

# OpenAI — used by the Worker only; never reaches the browser.
OPENAI_API_KEY="sk-..."

# Shared secret gating /api/*. 16 chars of Crockford-style base32 (no I/L/O/U),
# so it can be typed on the Tesla keyboard without misreading a character:
#   LC_ALL=C tr -dc '0-9A-HJKMNP-TV-Z' </dev/urandom | head -c16; echo
JARVIS_SHARED_SECRET=""

# Hermes agent (Nous Research hermes-agent api_server)
HERMES_BASE_URL="https://hermes.example.com"
HERMES_API_KEY=""            # = API_SERVER_KEY on the Hermes box
HERMES_MODEL=""              # optional; defaults to "hermes"

# Backend model that routes delegations. Usually left empty and chosen in the
# app's settings panel instead, which wins over this. Empty means gpt-6-luna.
ROUTER_MODEL=""

# Cloudflare Access service token fronting Hermes.
# The Access policy action MUST be "Service Auth", or you get an IdP login page.
CF_ACCESS_CLIENT_ID=""
CF_ACCESS_CLIENT_SECRET=""

# Google Maps, server-side (Routes, Static Maps, Street View, Geocoding).
# Must NOT be referrer-restricted: a Worker sends no referrer.
GOOGLE_MAPS_API_KEY=""

# Separate key for the interactive embed, which runs in the browser.
# Restrict this one BY REFERRER to the app's hostname, and to the Maps Embed API.
# Without it the app falls back to static, proxied imagery.
GOOGLE_MAPS_EMBED_KEY=""

# Tessie, from dash.tessie.com/settings/api. VIN is discovered from GET /vehicles.
TESSIE_TOKEN=""
TESSIE_VIN=""

# Home Assistant MCP. The webhook URL IS the credential, hence a secret.
HA_MCP_URL=""
HA_TOKEN=""

# Home Assistant origin, for the camera proxy and the Assist fast path.
# Must be reachable from Cloudflare, so a Nabu Casa or tunnel URL, not a LAN IP.
HA_BASE_URL="https://home.example.com"

# House requests from the glasses, Type and push-to-talk try Home Assistant's
# Assist before the AI. Optional; also in the settings panel under Home.
# HA_ASSIST: "0" always uses the AI instead (default 1).
# HA_ASSIST_LANGUAGE: language Assist is asked in (default en).
# HA_ASSIST="1"
# HA_ASSIST_LANGUAGE="en"

# Even Realities G2 glasses (POST /api/v1/chat/completions). All optional.
# G2_CHAR_BUDGET: characters the glasses show before cutting off (default 350).
# G2_WAIT_S: seconds to wait for an answer; the Even app hangs up at 300 (default 240).
# G2_CHAR_BUDGET="350"
# G2_WAIT_S="240"

# Spotify app credentials (developer.spotify.com/dashboard).
# Redirect URI must be exactly: https://jarvis.example.com/api/spotify/callback
# The refresh token is NOT set here — the OAuth callback writes it to KV.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google OAuth client for Gmail (console.cloud.google.com → Credentials →
# OAuth client ID → Web application).
# Redirect URI must be exactly: https://jarvis.example.com/api/google/callback
# Scopes requested: gmail.modify, userinfo.email. NOT mail.google.com —
# withholding it is what makes permanent deletion impossible by construction.
#
# PUBLISH THE CONSENT SCREEN TO "IN PRODUCTION". While it sits in "Testing",
# Google expires every refresh token after exactly 7 days and Gmail breaks
# weekly with invalid_grant. Publishing is self-service; it does not require
# passing verification, it only adds an "unverified app" screen at consent.
#
# The refresh token is NOT set here — the OAuth callback writes it to KV.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Alerts: how Jarvis reaches you when it speaks first. All optional — an open
# Jarvis screen and browser notifications need nothing set. Easier in the
# settings panel (Alerts), where Test sends one message down every channel.
# ALERT_ORDER="live,push,telegram,ntfy,webhook,homeassistant"
TELEGRAM_BOT_TOKEN=""        # from @BotFather
TELEGRAM_CHAT_ID=""          # your chat id; negative for a group
NTFY_URL=""                  # e.g. https://ntfy.sh/a-long-random-topic-name
NTFY_TOKEN=""                # only for a protected topic
ALERT_WEBHOOK_URL=""         # gets each alert as a JSON POST
ALERT_WEBHOOK_SECRET=""      # signs it: X-Jarvis-Signature: sha256=HMAC(body)
HA_NOTIFY_SERVICE=""         # e.g. mobile_app_pixel_9 (uses HA_BASE_URL + HA_TOKEN)
# HA_NOTIFY_SPEAK="0"        # "1": the Android Companion app reads alerts aloud

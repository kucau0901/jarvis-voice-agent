{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    // Lets lib modules import each other with an explicit .ts extension, which is
    // what allows Node to load them straight from test/ with no runner and no build.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true
  },
  // The app's half: the browser's types. The Worker's is tsconfig.worker.json,
  // with the Workers runtime's types instead; npm run typecheck runs both.
  "include": ["src/app/**/*.ts", "src/shared/**/*.ts"]
}
